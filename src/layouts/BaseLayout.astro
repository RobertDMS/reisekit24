---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site } from '../data/site.js';
import '../styles/global.css';

const { title, description, path, image, type, schema } = Astro.props;
const isUnderConstruction = site.underConstruction;
---
<!doctype html>
<html lang="de">
  <head>
    <!-- Google Consent Mode v2 default state. Optional scripts are loaded only after consent. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){dataLayer.push(arguments);}
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} path={path} image={image} type={type} schema={schema} />
  </head>
  <body class:list={[{ 'construction-body': isUnderConstruction }]}>
    {isUnderConstruction ? (
      <main class="construction-page" aria-labelledby="construction-title">
        <section class="construction-card">
          <img src={site.logo} alt="reisekit24 Logo" width="180" height="41" />
          <p class="pill-label">Seite im Aufbau</p>
          <h1 id="construction-title">reisekit24 ist bald verfügbar</h1>
          <p class="lead">Wir bereiten gerade die ersten Reise-Tipps, Ausflüge und Partnerlinks vor. Schau bald wieder vorbei.</p>
        </section>
      </main>
    ) : (
      <>
        <Header />
        <main>
          <slot />
        </main>
        <Footer />
      </>
    )}
    <CookieConsent />
  </body>
</html>
