---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import '../styles/global.css';

const { title, description, path, image, type, schema } = Astro.props;
const isUnderConstruction = site.underConstruction;
---
<!doctype html>
<html lang="de">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PRVJ2K6T');
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} path={path} image={image} type={type} schema={schema} />
    <!-- GetYourGuide Analytics -->
    <script async defer src="https://widget.getyourguide.com/dist/pa.umd.production.min.js" data-gyg-partner-id="A65YU5Z"></script>
  </head>
  <body class:list={[{ 'construction-body': isUnderConstruction }]}>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PRVJ2K6T"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    {isUnderConstruction ? (
      <main class="construction-page" aria-labelledby="construction-title">
        <section class="construction-card">
          <img src={site.logo} alt="reisekit24 Logo" width="180" height="41" />
          <p class="pill-label">Seite im Aufbau</p>
          <h1 id="construction-title">reisekit24 ist bald verfügbar</h1>
          <p class="lead">Wir bereiten gerade die ersten Reise-Tipps, Ausflüge und Partnerlinks vor. Schau bald wieder vorbei.</p>
        </section>
      </main>
    ) : (
      <>
        <Header />
        <main>
          <slot />
        </main>
        <Footer />
      </>
    )}
  </body>
</html>
