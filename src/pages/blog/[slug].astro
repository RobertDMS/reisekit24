---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { posts } from '../../data/blog.js';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const stripHtml = (value = '') => value.replace(/<[^>]*>/g, '');
const tocItems = post.sections?.filter((section) => section.id) ?? [];
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: post.dateModified ?? post.date,
  image: post.image,
  articleSection: post.category,
  keywords: post.keywords,
  author: { '@type': 'Organization', name: 'reisekit24' },
  publisher: { '@type': 'Organization', name: 'reisekit24' },
  mainEntityOfPage: `/blog/${post.slug}/`
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer ?? stripHtml(item.answerHtml) }
  }))
};
---
<BaseLayout title={post.seoTitle ?? post.title} description={post.description} path={`/blog/${post.slug}/`} image={post.image} type="article" schema={[articleSchema, faqSchema]}>
  <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.title, href: `/blog/${post.slug}/` }]} />
  <article>
    <section class="page-hero article-hero">
      <div class="container page-hero-grid">
        <div class="content">
          <p class="eyebrow">{post.category}</p>
          <h1>{post.title}</h1>
          <p class="lead">{post.intro}</p>
          {post.keyFacts && (
            <div class="article-facts" aria-label="Kurzinfos">
              {post.keyFacts.map((fact) => <span>{fact}</span>)}
            </div>
          )}
        </div>
        <img src={post.image} alt={post.alt} width="1200" height="675" />
      </div>
    </section>

    {post.quickAnswer && (
      <section class="section-tight">
        <div class="container article-answer-box">
          <p class="eyebrow">Schnelle Antwort</p>
          <h2>{post.quickAnswer.heading}</h2>
          <p>{post.quickAnswer.text}</p>
        </div>
      </section>
    )}

    <section class="section-tight">
      <div class="container article-layout">
        {tocItems.length > 0 && (
          <aside class="article-toc" aria-label="Inhalt">
            <strong>Inhalt</strong>
            <nav>
              {tocItems.map((section) => <a href={`#${section.id}`}>{section.heading}</a>)}
            </nav>
          </aside>
        )}

        <div class="article-body article-rich">
          {post.sections.map((section) => (
            <section id={section.id}>
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2>{section.heading}</h2>
              {section.body?.map((paragraph) => <p>{paragraph}</p>)}

              {section.bullets && (
                <ul class="article-check-list">
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}

              {section.cards && (
                <div class="article-card-grid">
                  {section.cards.map((card) => (
                    <article class="article-mini-card">
                      <h3>{card.title}</h3>
                      <p>{card.text}</p>
                    </article>
                  ))}
                </div>
              )}

              {section.table && (
                <div class="article-table-wrap">
                  <table>
                    <thead>
                      <tr>{section.table.columns.map((column) => <th>{column}</th>)}</tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {section.note && <aside class="article-note">{section.note}</aside>}

              {section.relatedLinks && (
                <div class="article-link-row">
                  {section.relatedLinks.map((link) => (
                    <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'sponsored nofollow noopener' : undefined}>{link.label}</a>
                  ))}
                </div>
              )}
            </section>
          ))}

          {post.finalCta && (
            <section class="article-final-cta">
              <div>
                <p class="eyebrow">{post.finalCta.eyebrow}</p>
                <h2>{post.finalCta.heading}</h2>
                <p>{post.finalCta.text}</p>
              </div>
              <div class="article-cta-actions">
                <a class="button" href={post.finalCta.primary.href} target={post.finalCta.primary.external ? '_blank' : undefined} rel={post.finalCta.primary.external ? 'sponsored nofollow noopener' : undefined}>{post.finalCta.primary.label}</a>
                {post.finalCta.secondary && <a class="button secondary" href={post.finalCta.secondary.href}>{post.finalCta.secondary.label}</a>}
              </div>
            </section>
          )}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2>Kurz beantwortet</h2>
        </div>
        <Faq items={post.faq} initialVisible={6} />
      </div>
    </section>
  </article>
</BaseLayout>
