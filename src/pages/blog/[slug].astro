---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { posts } from '../../data/blog.js';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  image: post.image,
  author: { '@type': 'Organization', name: 'reisekit24' }
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---
<BaseLayout title={post.title} description={post.description} path={`/blog/${post.slug}/`} image={post.image} type="article" schema={[articleSchema, faqSchema]}>
  <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.title, href: `/blog/${post.slug}/` }]} />
  <article>
    <section class="page-hero">
      <div class="container page-hero-grid">
        <div class="content">
          <p class="eyebrow">{post.category}</p>
          <h1>{post.title}</h1>
          <p class="lead">{post.intro}</p>
        </div>
        <img src={post.image} alt={post.alt} width="900" height="620" />
      </div>
    </section>
    <section class="section-tight">
      <div class="container content article-body">
        {post.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <p>{section.text}</p>
          </section>
        ))}
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2>Kurz beantwortet</h2>
        </div>
        <Faq items={post.faq} />
      </div>
    </section>
  </article>
</BaseLayout>
