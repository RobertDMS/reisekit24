---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import SeoContentBlock from '../components/SeoContentBlock.astro';
import { categories } from '../data/categories.js';
import { esimFaq } from '../data/faqs.js';
import { seoBlocks } from '../data/seoBlocks.js';

const page = categories.find((item) => item.id === 'esim');
const seoBlock = seoBlocks.esim;
const blocks = [
  { title: 'Was ist eine eSIM?', text: 'Eine eSIM ist eine digitale SIM-Karte. Du aktivierst sie auf dem Smartphone und brauchst keine physische Karte zu wechseln.' },
  { title: 'Wann lohnt sie sich?', text: 'Sie lohnt sich besonders, wenn du unterwegs Navigation, Messenger, Tickets und Reise-Apps nutzen möchtest.' },
  { title: 'eSIM vs. Roaming', text: 'Roaming ist bequem, kann außerhalb der EU aber teuer sein. Eine eSIM kann planbarer sein, wenn Datenvolumen und Laufzeit klar sind.' },
  { title: 'Für wen macht sie Sinn?', text: 'Für Städtereisen, Rundreisen, Remote Work, Solo-Trips und alle, die direkt nach der Ankunft online sein möchten.' }
];
const faq = esimFaq;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answerText ?? item.answer }
  }))
};
---
<BaseLayout
  title="eSIM für Reisen"
  description="Was eine eSIM ist, wann sie sich lohnt und wie sie sich von Roaming unterscheidet."
  path="/esim/"
  image={page.image}
  schema={[faqSchema]}
>
  <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: page.title, href: '/esim/' }]} />

  <section class="page-hero" id="angebote">
    <div class="container page-hero-grid">
      <div class="content">
        <p class="eyebrow">eSIM-Guide</p>
        <h1>Mit eSIM unterwegs online bleiben</h1>
        <p class="lead">Eine eSIM kann Reisen einfacher machen, wenn du mobile Daten vorab planen möchtest. Der Vergleich auf reisekit24 wird vorbereitet.</p>
        <span class="button muted-button" data-affiliate-url={page.affiliateUrl}>eSIM-Vergleich wird vorbereitet</span>
      </div>
      <img src={page.image} alt={page.alt} width="900" height="620" />
    </div>
  </section>

  <section class="section-tight" id="voraussetzungen">
    <div class="container grid two">
      {blocks.map((item) => (
        <article class="benefit">
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-tight" id="vergleich">
    <div class="container">
      <div class="cta-panel neutral">
        <div>
          <p class="eyebrow">In Vorbereitung</p>
          <h2>eSIM-Vergleich wird vorbereitet</h2>
          <p class="lead">Aktuell gibt es noch keinen aktiven eSIM-Partner. Bis dahin bleibt diese Seite ein kompakter Ratgeber.</p>
        </div>
        <span class="button muted-button" data-affiliate-url={page.affiliateUrl}>Anbieterübersicht folgt bald</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Häufige Fragen zu eSIM im Urlaub</h2>
        <p class="lead">Praktische Antworten auf wichtige Fragen zu eSIM, mobilem Internet und Nutzung im Urlaub.</p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <SeoContentBlock block={seoBlock} />
</BaseLayout>
