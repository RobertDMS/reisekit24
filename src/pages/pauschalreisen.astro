---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import SeoContentBlock from '../components/SeoContentBlock.astro';
import { categories } from '../data/categories.js';
import { pauschalreisenFaq } from '../data/faqs.js';
import { seoBlocks } from '../data/seoBlocks.js';

const page = categories.find((item) => item.id === 'pauschalreisen');
const seoBlock = seoBlocks.pauschalreisen;
const travelTypes = [
  { title: 'Familien', text: 'Pauschalreisen sind praktisch, wenn Flug, Hotel und oft auch Transfer zusammen geplant werden sollen.' },
  { title: 'Paare', text: 'Für Badeurlaub, kurze Auszeiten und entspannte Hotelwochen ist ein Paket oft angenehm übersichtlich.' },
  { title: 'Komfortsuchende', text: 'Wer wenig selbst organisieren möchte, profitiert von klaren Leistungen und einem festen Reiseplan.' },
  { title: 'Preisvergleicher', text: 'Ein Paket kann attraktiv sein, sollte aber immer mit Einzelbuchungen verglichen werden.' }
];
const faq = pauschalreisenFaq;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answerText ?? item.answer }
  }))
};
---
<BaseLayout
  title="Pauschalreisen einfach erklärt"
  description="Wann sich eine Pauschalreise lohnt und für wen Flug und Hotel als Paket sinnvoll sind."
  path="/pauschalreisen/"
  image={page.image}
  schema={[faqSchema]}
>
  <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: page.title, href: '/pauschalreisen/' }]} />

  <section class="page-hero" id="angebote">
    <div class="container page-hero-grid">
      <div class="content">
        <p class="eyebrow">Pauschalreise-Guide</p>
        <h1>Wann lohnt sich eine Pauschalreise?</h1>
        <p class="lead">Pauschalreisen sind sinnvoll, wenn du Flug und Hotel bequem zusammen buchen möchtest. Angebote und Partner werden auf reisekit24 noch vorbereitet.</p>
        <span class="button muted-button" data-affiliate-url={page.affiliateUrl}>Pauschalreise-Angebote folgen in Kürze</span>
      </div>
      <img src={page.image} alt={page.alt} width="900" height="620" />
    </div>
  </section>

  <section class="section-tight" id="all-inclusive">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Für wen?</p>
        <h2>Für diese Reisen kann ein Paket sinnvoll sein</h2>
      </div>
      <div class="grid four">
        {travelTypes.map((item) => (
          <article class="benefit">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" id="vergleich">
    <div class="container">
      <div class="cta-panel neutral">
        <div>
          <p class="eyebrow">In Vorbereitung</p>
          <h2>Pauschalreise-Angebote folgen in Kürze</h2>
          <p class="lead">Aktuell ist für Pauschalreisen noch kein aktiver Affiliate-Partner eingebunden. Diese Seite bleibt bis dahin informativ und transparent.</p>
        </div>
        <span class="button muted-button" data-affiliate-url={page.affiliateUrl}>Anbieterübersicht folgt bald</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Häufige Fragen zu Pauschalreisen und Urlaubspaketen</h2>
        <p class="lead">Praktische Antworten auf wichtige Fragen zu Buchung, Preis, Leistungen und Auswahl von Pauschalreisen.</p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <SeoContentBlock block={seoBlock} />
</BaseLayout>

