---
const { block, ctaOverride } = Astro.props;
const cta = ctaOverride ?? block?.cta;
---
{block && (
  <section class="section-tight">
    <div class="container seo-content-block">
      <div class="section-head">
        <p class="eyebrow">Kurzüberblick</p>
        <h2>{block.title}</h2>
        <p class="lead">{block.intro}</p>
      </div>

      <div class="seo-content-list">
        {block.sections.map((item) => (
          <article>
            <h3>{item.heading}</h3>
            {item.textHtml ? <p set:html={item.textHtml} /> : <p>{item.text}</p>}
          </article>
        ))}
      </div>

      {cta && (
        <div class="home-cta-links seo-content-cta">
          <h2>{cta.title}</h2>
          <div>
            {cta.links.map((link) => (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'sponsored nofollow noopener' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
