---
const { items = [] } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href
  }))
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
