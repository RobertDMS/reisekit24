---
import { site } from '../data/site.js';
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src={site.logo} alt="reisekit24 Logo" width="150" height="34" loading="lazy" />
      <p>Dein leichtes Travel Kit für Ausflüge, Hotels, eSIM und Pauschalreisen. Schnell finden, direkt beim Partner buchen.</p>
    </div>
    <div class="footer-columns">
      <nav aria-label="Reisebereiche">
        <strong>Reisekit</strong>
        <a href="/ausfluege/">Ausflüge</a>
        <a href="/hotels/">Hotels</a>
        <a href="/esim/">eSIM</a>
        <a href="/pauschalreisen/">Pauschalreisen</a>
      </nav>
      <nav aria-label="Informationen">
        <strong>Info</strong>
        <a href="/blog/">Blog</a>
        <a href="/ueber-uns/">Über uns</a>
      </nav>
      <nav aria-label="Rechtliches">
        <strong>Rechtliches</strong>
        <a href="/affiliate-hinweis/">Affiliate-Hinweis</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </nav>
    </div>
  </div>
</footer>
