---
import WidgetPlaceholder from './WidgetPlaceholder.astro';
import { categories } from '../data/categories.js';
import { airaloLinks } from '../data/airaloLinks.ts';
const category = categories.find((item) => item.id === 'esim');
---
<WidgetPlaceholder
  title="eSIM für deine Reise finden"
  partner="Airalo"
  description="Airalo bietet digitale eSIM-Datenpakete für viele Reiseziele. So kannst du mobiles Internet vor dem Urlaub einfacher vorbereiten."
  image={category.image}
  alt={category.alt}
  href={airaloLinks.main}
  cta="eSIM-Angebote ansehen"
/>
