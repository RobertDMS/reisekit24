---
import WidgetPlaceholder from './WidgetPlaceholder.astro';
import { categories } from '../data/categories.js';
const category = categories.find((item) => item.id === 'esim');
---
<WidgetPlaceholder
  title="eSIM für deine Reise vorbereiten"
  partner="eSIM-Guide"
  description="Für eSIM ist aktuell noch kein aktiver Affiliate-Partner eingebunden. Der Vergleich wird vorbereitet."
  image={category.image}
  alt={category.alt}
  href={category.affiliateUrl}
  cta="eSIM-Vergleich wird vorbereitet"
/>
